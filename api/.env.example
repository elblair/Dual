# Copy to api/.env (never commit .env).
# Neon connection string, e.g. postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Leave empty to use a local SQLite file (api/dev.db) for quick local runs.
DATABASE_URL=
# Any long random string, used to sign login tokens. Required when DATABASE_URL points at Postgres.
JWT_SECRET=
# Comma-separated list of allowed web origins, or * for any (fine for this demo).
CORS_ORIGINS=*
# Sign-up codes by email (Brevo free plan: brevo.com > SMTP & API > API keys). EMAIL_FROM must be a sender you verified in Brevo.
# Leave BREVO_API_KEY empty locally: the code is then printed in the uvicorn log.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Dual
