# Copy to .env (never commit .env). Restart with `npx expo start -c` after changes.
# API base URL (use your PC's LAN IP in dev, e.g. http://192.168.1.20:8000; Render URL in prod)
EXPO_PUBLIC_API_URL=
# true = run the whole app on the in-memory mock store (no network)
EXPO_PUBLIC_USE_MOCK=true
# true = show "Demo tools" on the You screen
EXPO_PUBLIC_DEMO=true
