# Copy to .env (never commit .env). Restart with `npx expo start -c` after changes.
# API base URL (REQUIRED). Without it the app shows an error instead of working.
# Deployed API (Render, Oregon; works from any phone, no PC needed; the free tier sleeps, the first call takes about a minute):
EXPO_PUBLIC_API_URL=https://dual-api-memp.onrender.com
# Or your own API while developing: http://localhost:8000 in the browser, your PC's LAN IP on a phone (e.g. http://192.168.1.20:8000).
# Never put DATABASE_URL or JWT_SECRET in this file: it is bundled into the app. They belong in api/.env or in Render.
# Leave this false. true is an explicit opt-in to an in-memory mock for ONE local user (nothing is saved, no other people);
# the app never switches to it by itself when the API is missing or down.
EXPO_PUBLIC_USE_MOCK=false
