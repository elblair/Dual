# Copy to .env (never commit .env). Restart with `npx expo start -c` after changes.
# API base URL. On a phone use your PC's LAN IP (e.g. http://192.168.1.20:8000); in the browser http://localhost:8000.
# After deploying: the Render URL.
EXPO_PUBLIC_API_URL=http://localhost:8000
# false = load everything from the API (and Neon). true = run the whole app on the in-memory mock (demo-day fallback).
EXPO_PUBLIC_USE_MOCK=false
# true = show "Demo tools" (and the Database screen) on the You screen, and give new accounts the day-5 demo duels.
EXPO_PUBLIC_DEMO=true
